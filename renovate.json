{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Etc/UTC",
  "schedule": ["* 6 * * 1-5"],
  "dependencyDashboard": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["(^|/)Dockerfile$"],
      "description": "pinned @deepseek-ai/dsh version ARG",
      "matchStrings": ["ARG DSH_VERSION=(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "@deepseek-ai/dsh",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["(^|/)Dockerfile$"],
      "description": "kubectl release pin inside its download URL",
      "matchStrings": [
        "https://dl\\.k8s\\.io/release/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)/bin/linux/\\$\\{ARCH\\}/kubectl"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["(^|/)Dockerfile$"],
      "description": "kubelogin release pin inside its download URL",
      "matchStrings": [
        "https://github\\.com/int128/kubelogin/releases/download/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)/kubelogin_linux_\\$\\{ARCH\\}\\.zip"
      ],
      "depNameTemplate": "int128/kubelogin",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["(^|/)Dockerfile$"],
      "description": "mise version ARG used by the mise download URL",
      "matchStrings": ["ARG MISE_VERSION=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the Node base image on the 24.x LTS line the harness supports",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node", "library/node"],
      "allowedVersions": "/^24(\\.|$)/"
    },
    {
      "description": "Harness prereleases need a deliberate bump",
      "matchPackageNames": ["@deepseek-ai/dsh"],
      "matchUpdateTypes": ["minor", "major", "patch"],
      "addLabels": ["harness-version"]
    }
  ]
}
